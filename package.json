{
  "name": "weavatrix-online",
  "version": "0.3.1",
  "description": "Source-free Weavatrix MCP connector for preview-gated Cloud/self-hosted graph sync, live advisories, malware review, and architecture contracts.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "Sergii Ziborov <sergii.ziborov@gmail.com>",
  "homepage": "https://weavatrix.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergii-ziborov/weavatrix-online.git"
  },
  "bugs": {
    "url": "https://github.com/sergii-ziborov/weavatrix-online/issues"
  },
  "mcpName": "io.github.sergii-ziborov/weavatrix-online",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "weavatrix-online": "bin/weavatrix-online.mjs"
  },
  "files": [
    "bin",
    "src",
    "skill",
    ".weavatrix/architecture.json",
    "docs/adr/0001-product-boundary.md",
    "docs/releases/v0.2.0.md",
    "docs/releases/v0.3.0.md",
    "docs/releases/v0.3.1.md",
    "README.md",
    "SECURITY.md",
    "LICENSE.md",
    "server.json"
  ],
  "scripts": {
    "test": "node --test",
    "verify:architecture": "node scripts/check-source-budgets.mjs",
    "verify:release": "npm run verify:architecture && node src/release-gate.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "weavatrix",
    "code-graph",
    "architecture",
    "codex",
    "openai-codex",
    "coding-agents",
    "claude",
    "ai-agents"
  ],
  "dependencies": {
    "weavatrix-js": "^0.3.15",
    "weavatrix-refactor": "^0.1.3"
  },
  "devDependencies": {}
}
